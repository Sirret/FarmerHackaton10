---
import Base from '../layouts/Base.astro';
import Card from '../components/shared/Card.astro';
import SessionBar from '../components/shared/SessionBar.jsx';
---
<Base title="Farmer">
  <h1 class="mb-4 text-2xl font-bold">Farmer phone</h1>
  <SessionBar client:only="preact" role="farmer" />
  <Card class="max-w-md">
    <p class="text-sm text-muted">The basic-phone simulator (Phone and Messages apps, USSD *1234#, voice *4321#) arrives in Phases 6 to 8.</p>
  </Card>
</Base>
