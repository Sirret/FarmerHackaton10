---
import Base from '../layouts/Base.astro';
import Card from '../components/shared/Card.astro';
import AccountTiles from '../components/shared/AccountTiles.jsx';
import { href } from '../lib/url.js';

const sections = [
  { role: 'farmer', title: 'Farmers', desc: 'Basic-phone simulator: *1234# text menu, *4321# voice call.', limit: 2 },
  { role: 'leader', title: 'Kafo leaders', desc: 'Smartphone app: plantings, buyer orders, produce and reports.', limit: 2 },
  { role: 'buyer', title: 'Buyers', desc: 'Post orders before planting, collect and pay.', limit: 2 },
] as const;
---
<Base title="Home">
  <section class="mb-8 max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight">Kafo Signal</h1>
    <p class="mt-2 text-muted">
      Green, yellow or red signals for what to plant, where to sell and what risk is coming,
      for women's vegetable garden groups (kafos) around Brikama. Click an account to log in.
    </p>
    <p class="mt-3 flex flex-wrap gap-3 text-sm">
      <a href={href('/about')} class="inline-flex min-h-11 items-center rounded-lg bg-brand px-4 font-semibold text-brand-ink hover:opacity-90">About &amp; 3-minute demo</a>
      <a href={href('/admin#demo')} class="inline-flex min-h-11 items-center rounded-lg border border-line bg-surface px-4 font-semibold hover:bg-soft">Demo controls</a>
    </p>
  </section>

  {sections.map((s) => (
    <section class="mb-8">
      <div class="mb-3 flex flex-wrap items-baseline gap-x-3">
        <h2 class="text-lg font-semibold">{s.title}</h2>
        <p class="text-sm text-muted">{s.desc}</p>
      </div>
      <AccountTiles client:only="preact" role={s.role} limit={s.limit} />
    </section>
  ))}

  <section class="mb-4">
    <h2 class="mb-3 text-lg font-semibold">Admin</h2>
    <a href={href('/admin')} class="block max-w-sm">
      <Card class="transition hover:border-accent">
        <p class="font-semibold">Kafo Signal Admin</p>
        <p class="mt-1 text-sm text-muted">Register kafos, verify buyers, prices, alerts and the demo panel. No login needed.</p>
      </Card>
    </a>
  </section>
</Base>
