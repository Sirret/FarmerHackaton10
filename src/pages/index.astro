---
import Base from '../layouts/Base.astro';
import Card from '../components/shared/Card.astro';
import { href } from '../lib/url.js';

const roles = [
  { path: '/farmer', title: 'Farmer', desc: 'Basic-phone simulator: dial *1234# for the text menu or *4321# for a voice call.' },
  { path: '/kafo', title: 'Kafo leader', desc: 'Smartphone app: log plantings, accept buyer orders, confirm produce and reports.' },
  { path: '/buyer', title: 'Buyer', desc: 'Post forward orders before planting, see the harvest outlook, collect and pay.' },
  { path: '/admin', title: 'Admin', desc: 'Register kafos, verify buyers, enter prices, send alerts and drive the demo.' },
];
---
<Base title="Home">
  <section class="mb-8 max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight">Kafo Signal</h1>
    <p class="mt-2 text-muted">
      Green, yellow or red signals for what to plant, where to sell and what risk is coming,
      for women's vegetable garden groups (kafos) around Brikama.
    </p>
  </section>

  <div class="grid gap-4 sm:grid-cols-2">
    {roles.map((r) => (
      <a href={href(r.path)} class="group block">
        <Card class="h-full transition group-hover:border-accent">
          <h2 class="text-lg font-semibold">{r.title}</h2>
          <p class="mt-1 text-sm text-muted">{r.desc}</p>
        </Card>
      </a>
    ))}
  </div>
</Base>
