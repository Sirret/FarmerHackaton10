---
import '../styles/global.css';
import { href } from '../lib/url.js';
import DemoDate from '../components/shared/DemoDate.jsx';

interface Props {
  title: string;
  wide?: boolean;
}
const { title, wide = true } = Astro.props;

const roles = [
  { path: '/farmer', label: 'Farmer' },
  { path: '/kafo', label: 'Kafo leader' },
  { path: '/buyer', label: 'Buyer' },
  { path: '/admin', label: 'Admin' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (path: string) => current === href(path).replace(/\/$/, '');
---
<!doctype html>
<html lang="en" data-theme="default">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} · Kafo Signal</title>
  </head>
  <body class="min-h-screen bg-page font-sans text-ink antialiased">
    <header class="bg-brand text-brand-ink">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-2">
        <a href={href('/')} class="mr-2 font-bold tracking-tight">Kafo Signal</a>
        <ul class="flex flex-wrap gap-1 text-sm">
          {roles.map((r) => (
            <li>
              <a
                href={href(r.path)}
                class={`rounded-md px-3 py-1.5 ${isActive(r.path) ? 'bg-brand-ink text-brand font-semibold' : 'hover:bg-accent'}`}
                aria-current={isActive(r.path) ? 'page' : undefined}
              >{r.label}</a>
            </li>
          ))}
        </ul>
        <div class="ml-auto flex items-center gap-2">
          <DemoDate client:only="preact" />
          <button id="reset-demo" type="button" class="rounded-md border border-brand-ink px-3 py-1.5 text-sm hover:bg-accent">
            Reset demo
          </button>
        </div>
      </nav>
    </header>

    <div id="db-error" hidden class="mx-auto mt-4 max-w-6xl px-4">
      <p role="alert" class="rounded-lg border border-stop bg-stop-soft px-4 py-3 text-sm text-ink">
        <strong>✕ This browser blocked the demo's local database.</strong>
        Kafo Signal keeps its demo data in the browser (IndexedDB). Turn off private/incognito mode or allow site data, then reload.
      </p>
    </div>

    <main class={wide ? 'mx-auto max-w-6xl px-4 py-6' : 'px-4 py-6'}>
      <slot />
    </main>

    <footer class="mx-auto max-w-6xl px-4 pb-6 text-xs text-muted">
      Prototype for UTG ITCA Hackathon 2026 · All names, phone numbers, prices and orders are demo data ·
      <a href={href('/about')} class="underline">About</a>
    </footer>

    <script>
      import { db, ready, resetDemo } from '../lib/db.js';

      // First visit seeds the in-browser database, then applies the configured theme.
      ready()
        .then(() => db.config.get('main'))
        .then((config) => {
          if (config?.theme) document.documentElement.dataset.theme = config.theme;
        })
        .catch((err) => {
          console.error('Seeding failed', err);
          document.getElementById('db-error')?.removeAttribute('hidden');
        });

      const btn = document.getElementById('reset-demo');
      btn?.addEventListener('click', async () => {
        if (!confirm('Reset all demo data to the starting state?')) return;
        btn.textContent = 'Resetting…';
        await resetDemo();
        btn.textContent = 'Reset ✓';
        setTimeout(() => (btn.textContent = 'Reset demo'), 1500);
      });
    </script>
  </body>
</html>
